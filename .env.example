# ─────────────────────────────────────────
# Hugging Face Inference API
# ─────────────────────────────────────────
# Generate a token at: https://huggingface.co/settings/tokens
# Required scope: "Inference API" (read access is sufficient)
HF_API_TOKEN=hf_your_token_here

# Which VLM to use (change to point at a private endpoint if needed)
HF_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct

# ─────────────────────────────────────────
# Backend Server
# ─────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ─────────────────────────────────────────
# CORS (comma-separated origins allowed)
# ─────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# -----------------------------------------
# Frontend (Vite)
# -----------------------------------------
# URL of the backend API, exposed to the browser bundle.
# Must start with VITE_ -- copy to frontend/.env.local for dev.
VITE_API_URL=http://localhost:8000
